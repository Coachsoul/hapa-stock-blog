---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';
return Astro.redirect('/');  // 유료 서비스 — 정식 오픈 전까지 숨김 (이 줄 제거 시 복구)
---

<BaseLayout title="VIP 구독" description="하파 VIP 구독으로 시나리오별 투자 전략, 리스크 관리, 매수/매도 타이밍 가이드를 받아보세요.">
  <main class="flex-grow">
    <div class="max-w-2xl mx-auto px-6 py-16">
      <!-- 런칭 특가 배너 -->
      <div class="bg-gradient-to-r from-primary-dark to-primary rounded-xl p-4 mb-8 text-center" id="promo-banner">
        <div class="flex items-center justify-center gap-2 text-white text-sm font-bold mb-1">
          <span class="material-symbols-outlined text-base">campaign</span>
          런칭 특가 진행 중
        </div>
        <p class="text-primary-light text-xs">지금 구독하시면 첫 달 특별 가격으로 시작할 수 있습니다</p>
      </div>

      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-light border border-accent/20 text-vip-gold text-sm font-bold mb-4">
          <span class="material-symbols-outlined text-sm">workspace_premium</span> VIP 프리미엄
        </div>
        <h1 class="text-2xl font-extrabold text-text mb-3">VIP 프리미엄 투자 노트</h1>
        <p class="text-text-secondary leading-relaxed">
          무료 노트의 교육 콘텐츠를 넘어,<br/>
          <strong class="text-text">실전 투자에 바로 적용할 수 있는 전략</strong>을 매일 아침 받아보세요.
        </p>
      </div>

      <!-- 비교 테이블 -->
      <div class="overflow-x-auto mb-10">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr>
              <th class="text-left py-3 px-4 bg-surface border-b border-border font-semibold text-text">혜택</th>
              <th class="text-center py-3 px-4 bg-surface border-b border-border font-semibold text-text w-20">무료</th>
              <th class="text-center py-3 px-4 bg-accent-light border-b border-accent/20 font-semibold text-vip-gold w-20">VIP</th>
            </tr>
          </thead>
          <tbody class="text-text-secondary">
            <tr><td class="py-2.5 px-4 border-b border-border">매일 시장 분석 (교육 관점)</td><td class="text-center border-b border-border text-primary">O</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
            <tr><td class="py-2.5 px-4 border-b border-border">오늘의 경제 용어 해설</td><td class="text-center border-b border-border text-primary">O</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
            <tr><td class="py-2.5 px-4 border-b border-border">시드머니별 자산배분 전략</td><td class="text-center border-b border-border text-primary">O</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
            <tr><td class="py-2.5 px-4 border-b border-border">시나리오별 포지션 전략 (강세/약세/횡보)</td><td class="text-center border-b border-border text-text-muted">-</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
            <tr><td class="py-2.5 px-4 border-b border-border">매수/매도 타이밍 가이드</td><td class="text-center border-b border-border text-text-muted">-</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
            <tr><td class="py-2.5 px-4 border-b border-border">리스크 관리 프레임워크</td><td class="text-center border-b border-border text-text-muted">-</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
            <tr><td class="py-2.5 px-4 border-b border-border">워치리스트 (3~5종목)</td><td class="text-center border-b border-border text-text-muted">-</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
            <tr><td class="py-2.5 px-4 border-b border-border">증권사 리포트 크로스체크</td><td class="text-center border-b border-border text-text-muted">-</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
            <tr><td class="py-2.5 px-4 border-b border-border font-semibold text-text">HAPA Flash 장중 투자 분석</td><td class="text-center border-b border-border text-text-muted">-</td><td class="text-center border-b border-border bg-accent-light/50 text-primary">O</td></tr>
          </tbody>
        </table>
      </div>

      <!-- HAPA Flash 소개 -->
      <div class="bg-[#1a1020] border border-red-500/20 rounded-xl p-6 mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded bg-red-600 text-white text-xs font-bold tracking-wider">FLASH</span>
          <h3 class="font-bold text-white">HAPA Flash 장중 투자 분석</h3>
          <span class="text-xs text-gray-400">VIP 전용</span>
        </div>
        <p class="text-sm text-gray-300 leading-relaxed mb-3">
          장중 주요 뉴스 발생 시, AI가 <strong class="text-white">투자 시사점을 분석</strong>하여
          VIP 구독자에게 행동 가이드와 함께 발송합니다.
        </p>
        <ul class="text-sm text-gray-300 space-y-2">
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5">&#9889;</span>
            <span>글로벌 주요 뉴스 모니터링 + AI 중요도 필터링</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5">&#9889;</span>
            <span>전쟁, 금리, 실적 서프라이즈 등 시장 영향 큰 이벤트 선별</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5">&#9889;</span>
            <span>뉴스 해석 + 포트폴리오 대응 가이드 포함</span>
          </li>
        </ul>
      </div>

      <!-- VIP 샘플 -->
      <div class="bg-bg-secondary rounded-xl overflow-hidden mb-10">
        <div class="flex items-center justify-between px-6 py-3 bg-surface border-b border-border">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-accent-light text-vip-gold text-xs font-bold">VIP</span>
            <span class="font-bold text-text text-sm">VIP 노트 예시</span>
          </div>
          <span class="text-xs text-text-muted">매일 아침 발송</span>
        </div>
        <div class="p-6 text-sm leading-relaxed space-y-4">
          <!-- 시나리오 A -->
          <div class="border-l-3 border-emerald-500 pl-4">
            <div class="flex items-center gap-2 mb-1">
              <strong class="text-emerald-600">시나리오 A (강세 60%)</strong>
              <span class="text-xs bg-emerald-50 text-emerald-700 px-1.5 py-0.5 rounded">신뢰도: 중</span>
            </div>
            <p class="text-text-secondary">반도체 섹터 중심 비중 확대. 삼성전자 60,000~62,000원 구간 분할 매수(3회) 검토.</p>
            <p class="text-text-secondary mt-1">근거: TSMC 1Q 가이던스 상향 [근거] + 외국인 3일 연속 순매수 [근거]</p>
          </div>
          <!-- 시나리오 B -->
          <div class="border-l-3 border-red-400 pl-4">
            <div class="flex items-center gap-2 mb-1">
              <strong class="text-red-500">시나리오 B (약세 30%)</strong>
              <span class="text-xs bg-red-50 text-red-600 px-1.5 py-0.5 rounded">신뢰도: 하</span>
            </div>
            <p class="text-text-secondary">방어적 포지션 전환. 비중: 공격 30% / 방어 40% / 현금 30%.</p>
          </div>
          <!-- 워치리스트 -->
          <div class="bg-surface rounded-lg p-4">
            <p class="font-semibold text-text mb-2">워치리스트 (3종목)</p>
            <div class="grid grid-cols-3 gap-2 text-xs text-text-secondary">
              <div class="bg-bg rounded p-2 text-center">
                <p class="font-semibold text-text">삼성전자</p>
                <p class="text-emerald-600">매수 60,000원</p>
              </div>
              <div class="bg-bg rounded p-2 text-center">
                <p class="font-semibold text-text">SK하이닉스</p>
                <p class="text-emerald-600">매수 180,000원</p>
              </div>
              <div class="bg-bg rounded p-2 text-center">
                <p class="font-semibold text-text">KODEX 200</p>
                <p class="text-text-muted">관망</p>
              </div>
            </div>
          </div>
          <!-- 리스크 -->
          <div class="flex items-start gap-2 text-xs text-text-muted bg-surface rounded-lg p-3">
            <span class="material-symbols-outlined text-sm text-amber-500 mt-0.5">warning</span>
            <span><strong class="text-text">리스크:</strong> 미국 CPI 발표 (목) 주의. 예상치 상회 시 시나리오 B로 전환. 손절 기준: -3%.</span>
          </div>
          <p class="text-xs text-text-muted italic">
            * 위 내용은 VIP 노트의 구성 예시입니다. 실제 노트는 당일 데이터 기반으로 작성됩니다.
          </p>
        </div>
      </div>

      <!-- 구독자 후기 -->
      <div class="mb-10">
        <h3 class="text-lg font-bold text-text mb-4">구독자 후기</h3>
        <Testimonials variant="compact" />
      </div>

      <!-- FAQ -->
      <div class="mb-10">
        <h3 class="text-lg font-bold text-text mb-4">자주 묻는 질문</h3>
        <div class="space-y-4">
          <div class="border border-border rounded-lg p-4">
            <p class="font-medium text-text mb-2">Q: 무료 구독과 VIP의 가장 큰 차이점은 무엇인가요?</p>
            <p class="text-sm text-text-secondary leading-relaxed">
              무료 노트는 시장을 이해하기 위한 교육 콘텐츠입니다.
              VIP 노트는 실전 투자에 바로 적용할 수 있는
              시나리오별 전략, 구체적 매수/매도 가이드, 리스크 관리 프레임워크를 제공합니다.
            </p>
          </div>
          <div class="border border-border rounded-lg p-4">
            <p class="font-medium text-text mb-2">Q: VIP 노트의 분석은 얼마나 정확한가요?</p>
            <p class="text-sm text-text-secondary leading-relaxed">
              모든 분석에는 신뢰도(상/중/하)를 표기하며, 근거 출처를 명시합니다.
              100% 정확한 투자 분석은 불가능하지만, 근거 기반의 체계적 분석으로
              투자 판단의 질을 높이는 것이 목표입니다.
            </p>
          </div>
          <div class="border border-border rounded-lg p-4">
            <p class="font-medium text-text mb-2">Q: 구독은 어떻게 시작하나요?</p>
            <p class="text-sm text-text-secondary leading-relaxed">
              위의 "지금 구독하기" 버튼을 클릭하면 결제 페이지로 이동합니다.
              카드 등록 후 자동으로 VIP 서비스가 시작됩니다.
              먼저 7일 무료 체험으로 시작하신 후 결제하시는 것도 좋은 방법입니다.
            </p>
          </div>
          <div class="border border-border rounded-lg p-4">
            <p class="font-medium text-text mb-2">Q: 해지는 어떻게 하나요?</p>
            <p class="text-sm text-text-secondary leading-relaxed">
              hapa_coach@naver.com으로 해지 요청을 보내시면 즉시 처리해드립니다.
              해지 후에도 결제 기간이 끝날 때까지 VIP 서비스를 이용하실 수 있습니다.
            </p>
          </div>
        </div>
      </div>

      <!-- 7일 무료 체험 CTA (Primary) -->
      <div class="bg-gradient-to-br from-[#1a1520] to-[#0f0a1a] border-2 border-accent/30 rounded-xl p-8 text-center mb-6">
        <h3 class="text-xl font-bold text-white mb-2">7일 무료 체험 시작하기</h3>
        <p class="text-sm text-gray-300 mb-5 leading-relaxed">
          VIP 투자 노트 + HAPA Flash 장중 분석을 7일간 무료로 받아보세요.<br/>
          카드 등록 없이 이메일만으로 시작합니다.
        </p>

        <form class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto mb-3" id="trial-form">
          <input
            type="email"
            name="email"
            placeholder="이메일 주소를 입력하세요"
            required
            autocomplete="email"
            class="flex-1 px-4 py-3 rounded-lg border border-amber-500/30 bg-white/10 text-sm text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500"
          />
          <button type="submit" class="px-6 py-3 rounded-lg bg-gradient-to-r from-amber-500 to-amber-600 text-white text-sm font-bold hover:from-amber-600 hover:to-amber-700 transition-all shadow-lg shadow-amber-500/20 whitespace-nowrap">
            <span class="trial-btn-text">무료 체험 시작</span>
            <span class="trial-btn-loading" hidden>처리 중...</span>
          </button>
        </form>
        <p class="hidden text-sm" id="trial-message"></p>
        <div class="flex items-center justify-center gap-3 text-xs text-gray-400 mt-3">
          <span>체험 중 언제든 해지 가능</span>
          <span class="text-gray-600">&middot;</span>
          <span>해지 시 비용 0원</span>
          <span class="text-gray-600">&middot;</span>
          <span>체험 후 자동으로 무료 구독 전환</span>
        </div>
      </div>

      <!-- 구분선 -->
      <div class="flex items-center gap-4 my-8">
        <div class="flex-1 border-t border-border"></div>
        <span class="text-sm text-text-muted">또는 바로 구독하기</span>
        <div class="flex-1 border-t border-border"></div>
      </div>

      <!-- 유료 구독 CTA (Secondary) -->
      <div class="bg-surface border border-border rounded-xl p-8 text-center mb-6">
        <h3 class="text-base font-bold text-text mb-2">유료 구독 바로 시작</h3>
        <p class="text-sm text-text-secondary mb-5">이미 마음을 정하셨다면 바로 시작하세요.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6 max-w-md mx-auto">
          <div class="border border-border rounded-lg p-4">
            <div class="text-sm text-text-secondary mb-1">월간</div>
            <div class="text-2xl font-extrabold text-text">19,900<span class="text-sm font-normal text-text-secondary">원/월</span></div>
          </div>
          <div class="border border-primary/30 rounded-lg p-4 relative">
            <div class="absolute -top-2 left-3 px-2 py-0.5 rounded bg-primary text-white text-xs font-bold">25% 할인</div>
            <div class="text-sm text-text-secondary mb-1">연간</div>
            <div class="text-2xl font-extrabold text-text">14,900<span class="text-sm font-normal text-text-secondary">원/월</span></div>
            <div class="text-xs text-text-muted">178,800원/년</div>
          </div>
        </div>
        <a href="/checkout" class="inline-flex items-center justify-center h-11 px-8 rounded-lg border border-amber-500/50 text-amber-500 font-bold text-sm hover:bg-amber-500/10 transition-all">
          구독하기
        </a>
        <div class="flex items-center justify-center gap-3 mt-4 text-xs text-text-muted">
          <span class="flex items-center gap-1"><span class="material-symbols-outlined text-xs">lock</span> 카드 정보는 PG사에서 안전 처리</span>
          <span>&middot;</span>
          <span class="flex items-center gap-1"><span class="material-symbols-outlined text-xs">cancel</span> 언제든 해지 가능</span>
        </div>
      </div>

      <p class="text-center text-sm text-text-muted">
        아직 고민되시나요? 먼저 <a href="/subscribe" class="text-primary hover:underline">무료 구독</a>으로 시작해보세요.
      </p>
    </div>
  </main>

  <script>
    const trialForm = document.getElementById('trial-form') as HTMLFormElement;
    const trialMsg = document.getElementById('trial-message') as HTMLElement;

    trialForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = new FormData(trialForm).get('email') as string;
      const btnText = trialForm.querySelector('.trial-btn-text') as HTMLElement;
      const btnLoading = trialForm.querySelector('.trial-btn-loading') as HTMLElement;
      const btn = trialForm.querySelector('button') as HTMLButtonElement;

      btn.disabled = true;
      btnText.hidden = true;
      btnLoading.hidden = false;

      try {
        const res = await fetch('/api/trial', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();

        trialMsg.hidden = false;
        trialMsg.classList.remove('hidden');
        if (res.ok) {
          trialMsg.textContent = data.message || 'VIP 7일 무료 체험이 시작되었습니다!';
          trialMsg.className = 'text-sm text-emerald-400';
          trialForm.reset();
        } else {
          trialMsg.textContent = data.error || '처리 중 문제가 발생했습니다.';
          trialMsg.className = 'text-sm text-red-400';
        }
      } catch {
        trialMsg.hidden = false;
        trialMsg.classList.remove('hidden');
        trialMsg.textContent = '서버에 연결할 수 없습니다. 잠시 후 다시 시도해주세요.';
        trialMsg.className = 'text-sm text-red-400';
      } finally {
        btn.disabled = false;
        btnText.hidden = false;
        btnLoading.hidden = true;
      }
    });
  </script>
</BaseLayout>
