---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import CategoryNav from '../components/CategoryNav.astro';

const allPosts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const latestPosts = allPosts.slice(0, 6);
---

<BaseLayout title="홈">
  <main class="flex-grow">

    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-primary-dark to-primary py-20 md:py-28">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-5 leading-tight">
          매일 아침, 시장을 읽는 힘을<br class="hidden md:block" />키워드립니다
        </h1>
        <p class="text-lg text-primary-light mb-8 max-w-2xl mx-auto leading-relaxed">
          하파와 함께 근거 기반 시장 분석과 맞춤 투자 전략을 받아보세요.<br class="hidden md:block" />
          주식이 두려운 초보자도 쉽게 이해할 수 있습니다.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/category/시장분석" class="inline-flex items-center justify-center h-12 px-8 rounded-lg bg-white text-primary-dark font-bold text-base hover:bg-primary-light transition-colors">
            📈 오늘의 시황 보기
          </a>
          <a href="/category/종목분석" class="inline-flex items-center justify-center h-12 px-8 rounded-lg bg-white/10 border border-white/30 text-white font-medium text-base hover:bg-white/20 transition-colors">
            💡 종목 분석 보기
          </a>
        </div>

        <!-- Social Proof -->
        <div class="mt-10 inline-flex flex-wrap justify-center gap-x-6 gap-y-2 px-5 py-3 rounded-full bg-white/10 backdrop-blur-sm text-sm text-white/80">
          <span><strong class="text-white font-bold">{allPosts.length}</strong>편 발행</span>
          <span class="text-white/30">|</span>
          <span>매일 <strong class="text-white font-bold">07:30</strong> 발송</span>
          <span class="text-white/30">|</span>
          <span>모든 분석 <strong class="text-white font-bold">출처 명시</strong></span>
        </div>
      </div>
    </section>

    <!-- 무료 노트 구성 -->
    <section class="border-b border-border py-8">
      <div class="max-w-6xl mx-auto px-6">
        <p class="text-center text-xs text-text-muted mb-4 uppercase tracking-wider font-medium">매일 아침 무료 노트에 포함되는 것</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div class="flex flex-col items-center gap-1.5">
            <span class="material-symbols-outlined text-primary text-xl">analytics</span>
            <p class="text-sm font-semibold text-text">시장 분석</p>
            <p class="text-xs text-text-muted">글로벌 + 국내 동향</p>
          </div>
          <div class="flex flex-col items-center gap-1.5">
            <span class="material-symbols-outlined text-primary text-xl">school</span>
            <p class="text-sm font-semibold text-text">용어 해설</p>
            <p class="text-xs text-text-muted">초보자도 쉽게 이해</p>
          </div>
          <div class="flex flex-col items-center gap-1.5">
            <span class="material-symbols-outlined text-primary text-xl">pie_chart</span>
            <p class="text-sm font-semibold text-text">자산배분 전략</p>
            <p class="text-xs text-text-muted">시드머니별 가이드</p>
          </div>
          <div class="flex flex-col items-center gap-1.5">
            <span class="material-symbols-outlined text-primary text-xl">checklist</span>
            <p class="text-sm font-semibold text-text">실수 방지</p>
            <p class="text-xs text-text-muted">초보자 체크리스트</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Posts -->
    <section class="py-16 px-6 max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
        <div>
          <h2 class="text-2xl font-bold text-text mb-2">최신 투자 노트</h2>
          <p class="text-text-secondary">매일 아침 업데이트되는 시장 분석과 투자 전략</p>
        </div>
        <a class="text-primary hover:text-primary-dark font-medium text-sm flex items-center gap-1" href="/category/시장분석">
          전체 보기 <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>

      <CategoryNav />

      {latestPosts.length === 0 ? (
        <p class="text-center text-text-muted py-16">아직 등록된 포스트가 없습니다.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {latestPosts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              category={post.data.category}
              readingTime={post.data.readingTime}
              slug={post.id}
            />
          ))}
        </div>
      )}
    </section>

    {/* 유료 서비스 섹션(구독자 후기·VIP CTA·이메일 구독)은 정식 오픈 전까지 제거 — 복구는 git 이력 참조 */}

  </main>
</BaseLayout>
