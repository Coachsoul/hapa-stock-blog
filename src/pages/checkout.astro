---
import BaseLayout from '../layouts/BaseLayout.astro';
return Astro.redirect('/');  // 유료 결제 — 정식 오픈 전까지 숨김 (이 줄 제거 시 복구)

const STORE_ID = (import.meta.env.PUBLIC_PORTONE_STORE_ID || '').trim();
const CHANNEL_KEY = (import.meta.env.PORTONE_CHANNEL_KEY || '').trim();
---

<BaseLayout title="VIP 구독 결제" description="하파 VIP 프리미엄 투자 노트 구독 결제 페이지">
  <main class="flex-grow">
    <div class="max-w-2xl mx-auto px-6 py-16">
      <!-- 런칭 특가 배너 -->
      <div class="bg-gradient-to-r from-amber-500 to-amber-600 rounded-lg px-4 py-2.5 mb-8 text-center">
        <p class="text-white text-sm font-bold flex items-center justify-center gap-1.5">
          <span class="material-symbols-outlined text-sm">campaign</span>
          런칭 특가 진행 중
        </p>
      </div>

      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-light border border-accent/20 text-vip-gold text-sm font-bold mb-4">
          <span class="material-symbols-outlined text-sm">workspace_premium</span> VIP 구독
        </div>
        <h1 class="text-2xl font-extrabold text-text mb-3">VIP 프리미엄 구독</h1>
        <p class="text-text-secondary leading-relaxed">
          매일 아침, 실전 투자 전략을 이메일로 받아보세요.
        </p>
      </div>

      <!-- VIP 혜택 요약 -->
      <div class="bg-bg-secondary rounded-xl p-5 mb-8">
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="text-primary font-bold">&#x2713;</span>시나리오별 투자 전략
          </div>
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="text-primary font-bold">&#x2713;</span>매수/매도 타이밍 가이드
          </div>
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="text-primary font-bold">&#x2713;</span>리스크 관리 프레임워크
          </div>
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="text-primary font-bold">&#x2713;</span>HAPA Flash 장중 투자 분석
          </div>
        </div>
      </div>

      <!-- 플랜 선택 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8" id="plan-cards">
        <!-- 월간 -->
        <button type="button" data-plan="monthly" data-amount="19900"
          class="plan-card group relative p-6 rounded-xl border-2 border-border bg-surface text-left transition-all hover:border-primary/50 cursor-pointer">
          <div class="text-sm text-text-secondary mb-1">월간 구독</div>
          <div class="text-2xl font-extrabold text-text mb-1">
            19,900<span class="text-sm font-normal text-text-secondary">원/월</span>
          </div>
          <div class="text-xs text-text-muted">매월 자동 갱신</div>
          <div class="plan-check hidden absolute top-3 right-3 size-6 rounded-full bg-primary text-white flex items-center justify-center">
            <span class="material-symbols-outlined text-sm">check</span>
          </div>
        </button>

        <!-- 연간 -->
        <button type="button" data-plan="annual" data-amount="178800"
          class="plan-card group relative p-6 rounded-xl border-2 border-border bg-surface text-left transition-all hover:border-primary/50 cursor-pointer">
          <div class="absolute -top-2.5 left-4 px-2 py-0.5 rounded bg-primary text-white text-xs font-bold">25% 할인</div>
          <div class="text-sm text-text-secondary mb-1">연간 구독</div>
          <div class="text-2xl font-extrabold text-text mb-1">
            14,900<span class="text-sm font-normal text-text-secondary">원/월</span>
          </div>
          <div class="text-xs text-text-muted">178,800원/년 일시 결제</div>
          <div class="plan-check hidden absolute top-3 right-3 size-6 rounded-full bg-primary text-white flex items-center justify-center">
            <span class="material-symbols-outlined text-sm">check</span>
          </div>
        </button>
      </div>

      <!-- 이름 입력 -->
      <div class="mb-4">
        <label for="checkout-name" class="block text-sm font-medium text-text mb-2">이름</label>
        <input
          type="text"
          id="checkout-name"
          placeholder="홍길동"
          required
          autocomplete="name"
          class="w-full px-4 py-3 rounded-lg border border-border bg-surface text-text text-sm placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"
        />
      </div>

      <!-- 이메일 입력 -->
      <div class="mb-4">
        <label for="checkout-email" class="block text-sm font-medium text-text mb-2">이메일 주소</label>
        <input
          type="email"
          id="checkout-email"
          placeholder="투자 노트를 받을 이메일을 입력하세요"
          required
          autocomplete="email"
          class="w-full px-4 py-3 rounded-lg border border-border bg-surface text-text text-sm placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"
        />
      </div>

      <!-- 휴대폰 번호 입력 -->
      <div class="mb-6">
        <label for="checkout-phone" class="block text-sm font-medium text-text mb-2">휴대폰 번호</label>
        <input
          type="tel"
          id="checkout-phone"
          placeholder="01012345678"
          required
          autocomplete="tel"
          maxlength="11"
          pattern="[0-9]{10,11}"
          class="w-full px-4 py-3 rounded-lg border border-border bg-surface text-text text-sm placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"
        />
        <p class="text-xs text-text-muted mt-1">결제 인증에 필요합니다 (하이픈 없이 입력)</p>
      </div>

      <!-- 결제 버튼 -->
      <button
        type="button"
        id="checkout-btn"
        disabled
        class="w-full py-3.5 rounded-lg bg-gradient-to-r from-amber-500 to-amber-600 text-white font-bold text-sm hover:from-amber-600 hover:to-amber-700 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span id="btn-text">플랜을 선택해주세요</span>
        <span id="btn-loading" hidden>결제 처리 중...</span>
      </button>

      <!-- 결과 메시지 -->
      <p id="checkout-message" class="hidden text-sm text-center mt-4"></p>

      <!-- 무료 체험 안내 -->
      <div class="mt-6 p-4 rounded-xl bg-accent-light/50 border border-accent/20 text-center">
        <div class="flex items-center justify-center gap-2 mb-1">
          <span class="material-symbols-outlined text-amber-500 text-base">lightbulb</span>
          <span class="font-bold text-sm text-text">결제 전에 먼저 체험해보세요</span>
        </div>
        <p class="text-xs text-text-secondary mb-2">카드 등록 없이 7일간 VIP 노트를 무료로 받아볼 수 있습니다.</p>
        <a href="/vip" class="text-xs text-primary font-semibold hover:underline">7일 무료 체험 시작하기 &rarr;</a>
      </div>

      <!-- 안내 -->
      <div class="mt-6 space-y-3 text-xs text-text-muted">
        <div class="flex items-start gap-2">
          <span class="material-symbols-outlined text-sm mt-0.5">lock</span>
          <span>결제 정보는 PG사에서 안전하게 처리되며, 하파 서버에 카드 정보가 저장되지 않습니다.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="material-symbols-outlined text-sm mt-0.5">autorenew</span>
          <span>구독은 자동 갱신되며, 갱신 3일 전에 안내 이메일을 보내드립니다.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="material-symbols-outlined text-sm mt-0.5">cancel</span>
          <span>언제든지 해지할 수 있으며, 현재 결제 기간이 끝날 때까지 서비스를 이용하실 수 있습니다.</span>
        </div>
      </div>

      <p class="text-center text-sm text-text-muted mt-6">
        결제 전에 <a href="/vip" class="text-primary hover:underline">VIP 혜택</a>을 확인해보세요.
      </p>
    </div>

    <!-- 소셜 프루프 토스트 -->
    <div id="social-toast" class="fixed bottom-6 left-6 z-50 max-w-xs bg-bg border border-border rounded-xl shadow-lg p-4 translate-y-20 opacity-0 transition-all duration-500 pointer-events-none">
      <div class="flex items-center gap-3">
        <div class="size-8 rounded-full bg-emerald-50 flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-emerald-600 text-sm">person</span>
        </div>
        <div>
          <p class="text-sm font-medium text-text" id="toast-text"></p>
          <p class="text-xs text-text-muted" id="toast-time"></p>
        </div>
      </div>
    </div>
  </main>

  <!-- PortOne V2 SDK -->
  <script is:inline src="https://cdn.portone.io/v2/browser-sdk.js"></script>

  <script define:vars={{ STORE_ID, CHANNEL_KEY }}>
    const planCards = document.querySelectorAll('.plan-card');
    const nameInput = document.getElementById('checkout-name');
    const emailInput = document.getElementById('checkout-email');
    const phoneInput = document.getElementById('checkout-phone');
    const checkoutBtn = document.getElementById('checkout-btn');
    const btnText = document.getElementById('btn-text');
    const btnLoading = document.getElementById('btn-loading');
    const msgEl = document.getElementById('checkout-message');

    let selectedPlan = null;
    let selectedAmount = 0;

    // 플랜 선택
    planCards.forEach(card => {
      card.addEventListener('click', () => {
        planCards.forEach(c => {
          c.classList.remove('border-primary', 'bg-primary-light/30');
          c.classList.add('border-border');
          c.querySelector('.plan-check')?.classList.add('hidden');
        });
        card.classList.remove('border-border');
        card.classList.add('border-primary', 'bg-primary-light/30');
        card.querySelector('.plan-check')?.classList.remove('hidden');

        selectedPlan = card.dataset.plan;
        selectedAmount = parseInt(card.dataset.amount);
        updateButton();
      });
    });

    // 입력 시 버튼 상태 업데이트
    nameInput.addEventListener('input', updateButton);
    emailInput.addEventListener('input', updateButton);
    phoneInput.addEventListener('input', updateButton);

    function updateButton() {
      const hasName = nameInput.value.trim().length >= 2;
      const hasEmail = emailInput.value.includes('@');
      const hasPhone = /^01[016789]\d{7,8}$/.test(phoneInput.value);
      checkoutBtn.disabled = !selectedPlan || !hasName || !hasEmail || !hasPhone;
      if (selectedPlan && hasName && hasEmail && hasPhone) {
        const label = selectedPlan === 'monthly' ? '월 19,900원' : '연 178,800원';
        btnText.textContent = `${label} 결제하기`;
      } else if (selectedPlan) {
        btnText.textContent = '이메일을 입력해주세요';
      } else {
        btnText.textContent = '플랜을 선택해주세요';
      }
    }

    // 결제 시작
    checkoutBtn.addEventListener('click', async () => {
      if (!selectedPlan || nameInput.value.trim().length < 2 || !emailInput.value.includes('@') || !/^01[016789]\d{7,8}$/.test(phoneInput.value)) return;

      checkoutBtn.disabled = true;
      btnText.hidden = true;
      btnLoading.hidden = false;
      msgEl.classList.add('hidden');

      try {
        // PortOne 빌링키 발급
        const planLabel = selectedPlan === 'monthly' ? '하파 VIP 월간 구독' : '하파 VIP 연간 구독';
        const issueId = `hapa_bill_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
        const response = await PortOne.requestIssueBillingKey({
          storeId: STORE_ID,
          channelKey: CHANNEL_KEY,
          billingKeyMethod: 'CARD',
          issueId,
          issueName: planLabel,
          customer: {
            fullName: nameInput.value.trim(),
            email: emailInput.value,
            phoneNumber: phoneInput.value,
          },
        });

        if (response.code) {
          throw new Error(response.message || '빌링키 발급에 실패했습니다.');
        }

        // 빌링키 발급 성공 → 서버에 결제 요청
        const res = await fetch('/api/payments/complete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            billingKey: response.billingKey,
            plan: selectedPlan,
            email: emailInput.value,
          }),
        });

        const data = await res.json();

        msgEl.classList.remove('hidden');
        if (res.ok && data.success) {
          msgEl.textContent = data.message || 'VIP 구독이 완료되었습니다!';
          msgEl.className = 'text-sm text-center mt-4 text-emerald-400';
          checkoutBtn.style.display = 'none';
        } else {
          msgEl.textContent = data.error || '결제 처리 중 문제가 발생했습니다.';
          msgEl.className = 'text-sm text-center mt-4 text-red-400';
        }
      } catch (err) {
        msgEl.classList.remove('hidden');
        if (err.message?.includes('사용자가 결제를 취소') || err.message?.includes('cancelled')) {
          msgEl.textContent = '결제가 취소되었습니다.';
        } else {
          msgEl.textContent = err.message || '결제 처리 중 오류가 발생했습니다.';
        }
        msgEl.className = 'text-sm text-center mt-4 text-red-400';
      } finally {
        checkoutBtn.disabled = false;
        btnText.hidden = false;
        btnLoading.hidden = true;
        updateButton();
      }
    });

    // 소셜 프루프 토스트
    (function() {
      const toast = document.getElementById('social-toast');
      const toastText = document.getElementById('toast-text');
      const toastTime = document.getElementById('toast-time');
      if (!toast || !toastText || !toastTime) return;

      const names = ['김**', '이**', '박**', '정**', '최**', '한**', '오**', '장**'];
      const plans = ['월간 구독', '연간 구독'];
      const times = ['3분 전', '12분 전', '27분 전', '1시간 전', '2시간 전', '오늘 오전'];

      let shown = 0;
      function show() {
        if (shown >= 3) return;
        const name = names[Math.floor(Math.random() * names.length)];
        const plan = plans[Math.floor(Math.random() * plans.length)];
        const time = times[Math.floor(Math.random() * times.length)];
        toastText.textContent = `${name}님이 ${plan}을 시작했습니다`;
        toastTime.textContent = time;
        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        shown++;
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0');
          toast.classList.remove('translate-y-0', 'opacity-100');
        }, 4000);
      }
      setTimeout(show, 8000);
      setTimeout(show, 25000);
      setTimeout(show, 50000);
    })();
  </script>
</BaseLayout>
